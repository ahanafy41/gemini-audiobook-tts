<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/repl_dialog_title"
            android:textColor="@color/primary_accessible"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/repl_dialog_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 1. Voice Name Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/repl_label_voice_name"
            android:textColor="@color/text_high_contrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editReplicationVoiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:hint="@string/repl_hint_voice_name"
            android:contentDescription="@string/repl_desc_voice_name"
            android:textColor="@color/text_high_contrast"
            android:textColorHint="@color/text_secondary"
            android:background="@color/surface_dark"
            android:padding="10dp"
            android:inputType="textPersonName" />

        <!-- 2. Reference Audio Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/repl_label_ref_audio"
            android:textColor="@color/text_high_contrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textRefAudioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/repl_status_no_sample"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRecordRefAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/repl_btn_record_sample"
                android:contentDescription="@string/repl_desc_record_sample"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary_accessible" />

            <Button
                android:id="@+id/btnPickRefAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/repl_btn_pick_file"
                android:contentDescription="@string/repl_desc_pick_file"
                android:textColor="@color/accent_control"
                android:backgroundTint="@color/surface_dark" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlayRefAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/repl_btn_preview_sample"
            android:contentDescription="@string/repl_desc_preview_sample"
            android:textColor="@color/text_high_contrast"
            android:backgroundTint="@color/divider_color" />

        <!-- 3. Consent Audio Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/repl_label_consent"
            android:textColor="@color/text_high_contrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@color/surface_dark"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/repl_prompt_read_aloud"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textConsentStatement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/repl_consent_text"
                android:textColor="@color/primary_accessible"
                android:textSize="14sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/repl_consent_meaning"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCopyConsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/repl_btn_copy_phrase"
                android:contentDescription="@string/repl_desc_copy_phrase"
                android:textColor="@color/accent_control"
                android:backgroundTint="@color/bg_dark" />
        </LinearLayout>

        <TextView
            android:id="@+id/textConsentAudioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/repl_status_no_consent"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRecordConsentAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/repl_btn_record_consent"
                android:contentDescription="@string/repl_desc_record_consent"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary_accessible" />

            <Button
                android:id="@+id/btnPickConsentAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/repl_btn_pick_file"
                android:contentDescription="@string/repl_desc_pick_consent"
                android:textColor="@color/accent_control"
                android:backgroundTint="@color/surface_dark" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlayConsentAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/repl_btn_preview_consent"
            android:contentDescription="@string/repl_desc_preview_consent"
            android:textColor="@color/text_high_contrast"
            android:backgroundTint="@color/divider_color" />

        <!-- 4. Submit & Action Buttons -->
        <Button
            android:id="@+id/btnSubmitReplication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/repl_btn_start"
            android:contentDescription="@string/repl_desc_start"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/primary_accessible" />

        <Button
            android:id="@+id/btnCancelReplication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/action_cancel"
            android:contentDescription="@string/repl_desc_cancel"
            android:textColor="@color/text_high_contrast"
            android:backgroundTint="@color/surface_dark" />

    </LinearLayout>

</ScrollView>
