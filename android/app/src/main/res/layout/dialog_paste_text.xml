<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Active Voice & Style Info -->
        <TextView
            android:id="@+id/textActiveVoiceSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصوت النشط: شارون | النمط: طبيعي"
            android:textColor="@color/accent_control"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <!-- Title Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عنوان المقطع (اختياري)"
            android:textColor="@color/text_high_contrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editPasteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:hint="أدخل عنواناً للمقطع أو اتركه فارغاً"
            android:contentDescription="حقل إدخال عنوان المقطع، اختياري"
            android:textColor="@color/text_high_contrast"
            android:textColorHint="@color/text_secondary"
            android:background="@color/surface_dark"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Paste from Clipboard Button -->
        <Button
            android:id="@+id/btnPasteFromClipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:text="لصق من الحافظة"
            android:contentDescription="زر سحب ولصق النص المنسوخ من الحافظة مباشرة"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/primary_accessible" />

        <!-- Content Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="النص المراد تحويله"
            android:textColor="@color/text_high_contrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editPasteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:maxHeight="260dp"
            android:layout_marginTop="4dp"
            android:hint="أدخل أو الصق النص هنا..."
            android:contentDescription="حقل إدخال النص لتحويله إلى كتاب صوتي"
            android:textColor="@color/text_high_contrast"
            android:textColorHint="@color/text_secondary"
            android:background="@color/surface_dark"
            android:padding="12dp"
            android:gravity="top|start"
            android:scrollbars="vertical"
            android:inputType="textMultiLine" />

        <!-- Character Count Indicator -->
        <TextView
            android:id="@+id/textPasteCharCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="عدد الحروف: 0"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
